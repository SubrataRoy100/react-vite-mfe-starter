{
  "name": "@mfe/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared constants, utilities, and cross-MFE event bus for the monorepo workspace",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./events": "./src/events/mfe-events.js",
    "./events/core": "./src/events/mfe-events-core.js",
    "./constants": "./src/constants/config.js",
    "./components/Button": "./src/components/Button.jsx",
    "./adapters": {
      "types": "./src/adapters/index.d.ts",
      "default": "./src/adapters/index.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    }
  },
  "scripts": {
    "build": "echo @mfe/shared is ready",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@originjs/vite-plugin-federation": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.0"
  }
}
